<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fuel_bg"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/screen_padding_horizontal"
    android:paddingTop="@dimen/screen_padding_top"
    android:paddingBottom="@dimen/screen_padding_bottom">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/app_name"
        android:textColor="@color/fuel_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:letterSpacing="-0.02" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="28dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_title"
                android:textColor="@color/fuel_text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/onboarding_subtitle"
                android:textColor="@color/fuel_muted"
                android:textSize="15sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/carNameLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:hint="@string/label_car_name"
                app:boxBackgroundColor="@color/fuel_surface"
                app:boxStrokeColor="@color/text_input_box_stroke"
                app:hintTextColor="@color/fuel_muted">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/carNameInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:imeOptions="actionNext"
                    android:maxLines="1"
                    android:textColor="@color/fuel_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/consumptionLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="@string/label_consumption"
                app:boxBackgroundColor="@color/fuel_surface"
                app:boxStrokeColor="@color/text_input_box_stroke"
                app:hintTextColor="@color/fuel_muted"
                app:suffixText="@string/suffix_l_per_100km"
                app:suffixTextColor="@color/fuel_muted">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/consumptionInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:imeOptions="actionNext"
                    android:textColor="@color/fuel_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tankCapacityLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="@string/label_tank_capacity"
                app:boxBackgroundColor="@color/fuel_surface"
                app:boxStrokeColor="@color/text_input_box_stroke"
                app:hintTextColor="@color/fuel_muted"
                app:suffixText="@string/suffix_liters"
                app:suffixTextColor="@color/fuel_muted">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/tankCapacityInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:imeOptions="actionNext"
                    android:textColor="@color/fuel_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/currentKmLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="@string/label_current_km"
                app:boxBackgroundColor="@color/fuel_surface"
                app:boxStrokeColor="@color/text_input_box_stroke"
                app:hintTextColor="@color/fuel_muted"
                app:suffixText="@string/suffix_km"
                app:suffixTextColor="@color/fuel_muted">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/currentKmInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:imeOptions="actionDone"
                    android:textColor="@color/fuel_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/full_tank_note"
                android:textColor="@color/fuel_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/formError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/fuel_error"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/getStartedButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/fuel_primary"
        android:text="@string/action_get_started"
        android:textAllCaps="false"
        android:textColor="@color/fuel_on_primary"
        android:textSize="16sp"
        app:cornerRadius="12dp" />
</LinearLayout>
