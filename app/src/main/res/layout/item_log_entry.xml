<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_log_item"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp">

    <TextView
        android:id="@+id/entryType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/fuel_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/log_label_date"
            android:textColor="@color/fuel_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/entryDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/fuel_text"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/log_label_fuel_added"
            android:textColor="@color/fuel_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/entryFuelAdded"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/fuel_text"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/log_label_odometer"
            android:textColor="@color/fuel_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/entryOdometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/fuel_text"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
