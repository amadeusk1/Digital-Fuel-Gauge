<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fuel_bg"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/screen_padding_horizontal"
    android:paddingTop="12dp"
    android:paddingBottom="@dimen/screen_padding_bottom">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back"
            android:tint="@color/fuel_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/fuel_added_title"
            android:textColor="@color/fuel_text"
            android:textSize="18sp"
            android:textStyle="bold" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fuel_added_subtitle"
                android:textColor="@color/fuel_muted"
                android:textSize="15sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/currentKmLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:hint="@string/label_current_km"
                app:boxBackgroundColor="@color/fuel_surface"
                app:boxStrokeColor="@color/text_input_box_stroke"
                app:hintTextColor="@color/fuel_muted"
                app:suffixText="@string/suffix_km"
                app:suffixTextColor="@color/fuel_muted">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/currentKmInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:imeOptions="actionNext"
                    android:textColor="@color/fuel_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/lastFullLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="@string/label_last_full_km"
                app:boxBackgroundColor="@color/fuel_surface"
                app:boxStrokeColor="@color/text_input_box_stroke"
                app:hintTextColor="@color/fuel_muted"
                app:helperTextTextColor="@color/fuel_muted"
                app:suffixText="@string/suffix_km"
                app:suffixTextColor="@color/fuel_muted">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/lastFullInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:imeOptions="actionNext"
                    android:textColor="@color/fuel_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/label_fuel_amount"
                android:textColor="@color/fuel_section_label"
                android:textSize="12sp"
                android:textAllCaps="true"
                android:letterSpacing="0.08" />

            <LinearLayout
                android:id="@+id/litersOption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_fuel_option"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/option_type_liters"
                    android:textColor="@color/fuel_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/litersAddedLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="@string/label_liters_added"
                    app:boxBackgroundColor="@color/fuel_bg"
                    app:boxStrokeColor="@color/text_input_box_stroke"
                    app:hintTextColor="@color/fuel_muted"
                    app:suffixText="@string/suffix_liters"
                    app:suffixTextColor="@color/fuel_muted">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/litersAddedInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:imeOptions="actionDone"
                        android:textColor="@color/fuel_text" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/label_or"
                android:textColor="@color/fuel_muted"
                android:textSize="13sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/fullTankOption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_fuel_option"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="14dp"
                android:paddingVertical="16dp">

                <TextView
                    android:id="@+id/fullTankLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="28dp"
                    android:text="@string/option_full_tank"
                    android:textColor="@color/fuel_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/fullTankCheck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:text="@string/option_selected_mark"
                    android:textColor="@color/fuel_primary"
                    android:textSize="18sp"
                    android:visibility="gone" />
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addFuelButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/fuel_primary"
                android:text="@string/action_fuel_added"
                android:textAllCaps="false"
                android:textColor="@color/fuel_on_primary"
                android:textSize="16sp"
                app:cornerRadius="12dp" />

            <TextView
                android:id="@+id/formError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/fuel_error"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/statusMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/fuel_primary"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
