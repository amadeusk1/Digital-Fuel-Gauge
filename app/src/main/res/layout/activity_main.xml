<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fuel_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding_horizontal"
            android:paddingTop="@dimen/screen_padding_top"
            android:paddingBottom="@dimen/screen_padding_bottom">

            <!-- Top bar: GPS + brand + stations -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/top_bar_height">

                <ImageButton
                    android:id="@+id/gpsButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_gps"
                    android:padding="10dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_gps"
                    android:tint="@color/fuel_primary" />

                <TextView
                    android:id="@+id/titleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="@string/app_name"
                    android:textAlignment="center"
                    android:textColor="@color/fuel_primary"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.03" />

                <ImageButton
                    android:id="@+id/stationsButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_gas_stations"
                    android:padding="10dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_gas_station_nav"
                    android:tint="@color/fuel_primary" />
            </FrameLayout>

            <TextView
                android:id="@+id/gpsStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textColor="@color/fuel_primary"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Gauge hero with glow -->
            <FrameLayout
                android:id="@+id/gaugeSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <View
                    android:layout_width="@dimen/gauge_glow_size"
                    android:layout_height="@dimen/gauge_glow_size"
                    android:layout_gravity="center_horizontal|top"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_gauge_glow" />

                <com.fuelcheck.GasGaugeView
                    android:id="@+id/gasGauge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal" />
            </FrameLayout>

            <!-- Status under gauge -->
            <TextView
                android:id="@+id/statusLiters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="@string/status_empty"
                android:textColor="@color/fuel_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusRange"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/status_spacing"
                android:gravity="center"
                android:textColor="@color/fuel_muted"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/calculateButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="@color/fuel_primary"
                android:text="@string/action_calculate"
                android:textAllCaps="false"
                android:textColor="@color/fuel_on_primary"
                android:textSize="16sp"
                app:cornerRadius="12dp" />

            <TextView
                android:id="@+id/formError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/fuel_error"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Trip -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_spacing"
                android:text="@string/section_trip"
                android:textAllCaps="true"
                android:textColor="@color/fuel_section_label"
                android:textSize="12sp"
                android:letterSpacing="0.08" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/currentKmLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/label_current_km"
                app:boxBackgroundColor="@color/fuel_surface"
                app:boxStrokeColor="@color/text_input_box_stroke"
                app:hintTextColor="@color/fuel_muted"
                app:suffixText="@string/suffix_km"
                app:suffixTextColor="@color/fuel_muted">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/currentKmInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:imeOptions="actionNext"
                    android:textColor="@color/fuel_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/fuelAddedButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="@string/action_fuel_added"
                android:textAllCaps="false"
                android:textColor="@color/fuel_primary"
                app:cornerRadius="12dp"
                app:strokeColor="@color/fuel_primary"
                app:strokeWidth="1.5dp" />

            <!-- Vehicle: 2-column -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_spacing"
                android:text="@string/section_vehicle"
                android:textAllCaps="true"
                android:textColor="@color/fuel_section_label"
                android:textSize="12sp"
                android:letterSpacing="0.08" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/consumptionLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:hint="@string/label_consumption"
                    app:boxBackgroundColor="@color/fuel_surface"
                    app:boxStrokeColor="@color/text_input_box_stroke"
                    app:hintTextColor="@color/fuel_muted"
                    app:suffixText="@string/suffix_l_per_100km"
                    app:suffixTextColor="@color/fuel_muted">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/consumptionInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:imeOptions="actionNext"
                        android:textColor="@color/fuel_text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tankCapacityLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:hint="@string/label_tank_capacity"
                    app:boxBackgroundColor="@color/fuel_surface"
                    app:boxStrokeColor="@color/text_input_box_stroke"
                    app:hintTextColor="@color/fuel_muted"
                    app:suffixText="@string/suffix_liters"
                    app:suffixTextColor="@color/fuel_muted">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/tankCapacityInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:imeOptions="actionDone"
                        android:textColor="@color/fuel_text" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
